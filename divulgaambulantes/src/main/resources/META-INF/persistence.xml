<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="default" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        
        <!-- Todas as entidades do projeto -->
        <class>br.edu.divulgaambulantes.entity.User</class>
        <class>br.edu.divulgaambulantes.entity.Product</class>
        <class>br.edu.divulgaambulantes.entity.Review</class>
        <class>br.edu.divulgaambulantes.entity.Favorite</class>
        <class>br.edu.divulgaambulantes.entity.Like</class>
        <class>br.edu.divulgaambulantes.entity.Location</class>
        <class>br.edu.divulgaambulantes.entity.Event</class>
        <class>br.edu.divulgaambulantes.entity.ProductClick</class>
        <class>br.edu.divulgaambulantes.entity.PageSession</class>
        <class>br.edu.divulgaambulantes.entity.ReviewView</class>
        <class>br.edu.divulgaambulantes.entity.Report</class>
        <class>br.edu.divulgaambulantes.entity.DeviceToken</class>
        <class>br.edu.divulgaambulantes.entity.Notification</class>
        <class>br.edu.divulgaambulantes.entity.AuditLog</class>
        <class>br.edu.divulgaambulantes.entity.ConsentLog</class>
        <class>br.edu.divulgaambulantes.entity.CommunityEvent</class>
        
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/divulgaambulantes"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="root"/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.ddl-generation" value="none"/>
        </properties>
    </persistence-unit>
</persistence>